# Copy this file to .env.local and fill in real values.
# Required: an OpenRouter API key (https://openrouter.ai/).
OPENROUTER_API_KEY=

# Optional: model override. Defaults to a free model in lib/llm/openrouter.ts.
# Recommended free fallback: google/gemini-2.0-flash-exp:free
# For higher quality, try: anthropic/claude-3.5-haiku, openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional: referrer header sent with OpenRouter requests.
OPENROUTER_REFERER=http://localhost:3000
